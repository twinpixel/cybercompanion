{
  "_nota": "Caratteristiche di Cyberpunk 2020, edizione italiana. Le sigle sono quelle stampate sulla Cyberscheda ufficiale (doc/Cyberpunk 2020 - Cyberscheda.pdf), non quelle inglesi. Riferimento: doc/regole/01-caratteristiche.md",

  "caratteristiche": [
    { "key": "INT",  "nome": "Intelligenza", "en": "INT",  "desc": "Ragionare, ricordare, risolvere problemi." },
    { "key": "RIF",  "nome": "Riflessi",     "en": "REF",  "desc": "Velocita' di reazione e coordinazione. La piu' importante in combattimento." },
    { "key": "TEC",  "nome": "Tecnologia",   "en": "TECH", "desc": "Abilita' manuale nel costruire, riparare, manomettere." },
    { "key": "FRE",  "nome": "Freddezza",    "en": "COOL", "desc": "Autocontrollo sotto pressione, resistenza allo stordimento." },
    { "key": "FAS",  "nome": "Fascino",      "en": "ATTR", "desc": "Aspetto fisico e capacita' di farsi notare." },
    { "key": "FOR",  "nome": "Fortuna",      "en": "LUCK", "desc": "Punti spendibili sui tiri, si ricaricano a ogni sessione." },
    { "key": "MOV",  "nome": "Movimento",    "en": "MA",   "desc": "Quanto si e' veloci a spostarsi." },
    { "key": "COS",  "nome": "Costituzione", "en": "BODY", "desc": "Robustezza fisica: danni assorbiti e peso sollevato." },
    { "key": "EMP",  "nome": "Empatia",      "en": "EMP",  "desc": "Contatto con gli altri. Cala installando cyberware." }
  ],

  "generazione": {
    "min": 2,
    "max": 10,
    "_metodo_casuale": "9d10, un dado per caratteristica.",
    "punti": [
      { "id": "sfigato",     "nome": "Sfigato",      "totale": 45 },
      { "id": "medio",       "nome": "Nella media",  "totale": 50 },
      { "id": "capace",      "nome": "Capace",       "totale": 60 },
      { "id": "eroico",      "nome": "Eroico",       "totale": 70 },
      { "id": "leggendario", "nome": "Leggendario",  "totale": 80 }
    ],
    "punti_default": 60
  },

  "derivate": [
    { "key": "corsa",       "nome": "Corsa",              "formula": "MOV * 3",  "unita": "m/turno" },
    { "key": "salto",       "nome": "Salto",              "formula": "MOV * 3 / 4", "unita": "m" },
    { "key": "sollevabile", "nome": "Peso sollevabile",   "formula": "COS * 40", "unita": "kg" },
    { "key": "trasporto",   "nome": "Peso trasportabile", "formula": "COS * 10", "unita": "kg" },
    { "key": "umanita",     "nome": "Umanita'",           "formula": "EMP * 10", "unita": "punti" },
    { "key": "salvezza",    "nome": "Tiro salvezza",      "formula": "COS",      "unita": "" }
  ],

  "_bonus_costituzione": "Bonus resistenza: si sottrae ai danni subiti dopo l'armatura. Bonus danno: si somma ai danni inflitti in corpo a corpo. La fascia 11+ estende la tabella del manuale, che si ferma a 10 pur essendo COS>10 raggiungibile col cyberware.",
